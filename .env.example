# Copy to .env and fill in only what you need. The repository runs with none of
# these set: generation.backend=offline is the default and needs no credentials.

# Hosted API backend (configs/openai.yaml)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # or any compatible gateway

# Local model backend (configs/ollama.yaml)
# OLLAMA_HOST=http://localhost:11434

# Logging: DEBUG | INFO | WARNING
RAGEVALS_LOG=INFO
